# ─────────────────────────────────────────────────────────────
# DATASPHERE 2026 — template environment variable
# Salin menjadi .env.local (lokal) dan isi di Vercel → Project → Settings → Environment Variables.
# JANGAN commit .env.local. File ini (.env.local.example) hanya berisi nama variabel, tanpa nilai.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Dashboard → Project Settings → API) ──
# Publik: aman terlihat di browser karena data dilindungi RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA — service role melewati RLS. Hanya dipakai server (lib/supabase/service.ts).
# JANGAN pernah diberi prefix NEXT_PUBLIC_ dan jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add widget) ──
# Site key boleh publik (dirender di browser) sehingga memakai prefix NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# RAHASIA — dipakai server untuk memverifikasi token.
TURNSTILE_SECRET_KEY=
# Untuk uji lokal bisa memakai kunci tes resmi Cloudflare (selalu lolos):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Tanpa TURNSTILE_SECRET_KEY: development melewati captcha, production MENOLAK semua submit.

# ── Alamat website (untuk pratinjau link, robots.txt, sitemap) ──
# Contoh: https://datasphere.darmajaya.ac.id — di Vercel boleh dikosongkan (otomatis memakai domain production).
NEXT_PUBLIC_SITE_URL=
